<?xml version="1.0" encoding="UTF-8"?>
<!--
  My Mail Notes – Outlook add-in manifest.
  Works in Outlook on the web, new Outlook for Windows and classic Outlook for Windows/Mac.
  Configured for https://pawpinku2-cmd.github.io/mail-notes
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>3e50212e-1253-46ed-a84c-7bbfd1341cf8</Id>
  <Version>1.1.0.0</Version>
  <ProviderName>Onovo IT</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="My Mail Notes"/>
  <Description DefaultValue="Add private notes to emails and meetings. Notes are stored on the item in your own mailbox and are never sent to anyone. Items with notes are tagged with a colour category."/>
  <IconUrl DefaultValue="https://pawpinku2-cmd.github.io/mail-notes/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://pawpinku2-cmd.github.io/mail-notes/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://pawpinku2-cmd.github.io/mail-notes/"/>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.8"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://pawpinku2-cmd.github.io/mail-notes/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <!-- Least privilege: the open email only. ReadWriteItem is needed to set the "Note" category.
       No access to other emails, no mailbox-wide access, no network permissions. -->
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>true</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.8">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="mailNotesGroup">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="mailNotesOpenPane">
                    <Label resid="PaneButton.Label"/>
                    <Supertip>
                      <Title resid="PaneButton.Label"/>
                      <Description resid="PaneButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16"/>
                      <bt:Image size="32" resid="Icon.32"/>
                      <bt:Image size="80" resid="Icon.80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <ExtensionPoint xsi:type="AppointmentAttendeeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="mailNotesApptGroup">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="mailNotesOpenPaneAppt">
                    <Label resid="PaneButton.Label"/>
                    <Supertip>
                      <Title resid="PaneButton.Label"/>
                      <Description resid="PaneButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16"/>
                      <bt:Image size="32" resid="Icon.32"/>
                      <bt:Image size="80" resid="Icon.80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16" DefaultValue="https://pawpinku2-cmd.github.io/mail-notes/assets/icon-16.png"/>
          <bt:Image id="Icon.32" DefaultValue="https://pawpinku2-cmd.github.io/mail-notes/assets/icon-32.png"/>
          <bt:Image id="Icon.80" DefaultValue="https://pawpinku2-cmd.github.io/mail-notes/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Taskpane.Url" DefaultValue="https://pawpinku2-cmd.github.io/mail-notes/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="My Mail Notes"/>
          <bt:String id="PaneButton.Label" DefaultValue="Notes"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="PaneButton.Tooltip" DefaultValue="View or add your private note for this email or meeting."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
